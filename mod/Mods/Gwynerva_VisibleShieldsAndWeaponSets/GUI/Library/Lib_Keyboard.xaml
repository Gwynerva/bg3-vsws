<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:ls="clr-namespace:ls;assembly=Code"
                    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
                    xmlns:System="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <!-- Generated by scripts/gen_ui.py from the game's CharacterSheetTemplates_k.xaml. -->


    <ControlTemplate x:Key="VSWS_VisibilityButtonTemplate" TargetType="ls:LSButton">
        <Grid>
            <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                <Rectangle Width="40" Height="40" Fill="#E60A0605" IsHitTestVisible="False"/>
                <Image x:Name="frame" VerticalAlignment="Center" HorizontalAlignment="Center" Source="pack://application:,,,/Core;component/Assets/Equipment/toggle_visibility_d_active.png" Stretch="None"/>
                <Image x:Name="icon" VerticalAlignment="Center" HorizontalAlignment="Center" Source="{DynamicResource IconNormal}" Stretch="None">
                    <!-- Default is hidden-->
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Resources>
                                <ImageSource x:Key="IconNormal">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_none_d.png</ImageSource>
                                <ImageSource x:Key="IconHighlight">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_none_h.png</ImageSource>
                                <ImageSource x:Key="IconPressed">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_none_h.png</ImageSource>
                            </Style.Resources>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="VSWS_SetMark" Source="pack://application:,,,/Core;component/Assets/CharacterPanel_c/c_ico_equipment_meleeSet_h.png" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <RotateTransform Angle="-45"/>
                    </Image.RenderTransform>
                    <Image.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="5" Color="Black" Opacity="0.85"/>
                    </Image.Effect>
                </Image>
                <Rectangle Fill="{StaticResource LS_DisabledPanelColor}" Visibility="{Binding Tag, ElementName=CharacterPanelHolder, Converter={StaticResource BoolToCollapsedConverter}}"/>
                <Rectangle x:Name="DimDownVisibilityCover" Width="40" Height="40" Opacity="0.6" Fill="Black" IsHitTestVisible="False"/>
            </Grid>
            <Border x:Name="VSWS_Label" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,-900,0" Background="#E60A0605" BorderBrush="#99413227" BorderThickness="2" CornerRadius="6" Padding="14,4,14,6">
                <TextBlock Name="HelmetToggleString" Text="{Binding Source='h153c3f7cga3aeg4d25gb8dcg439be99a27e1',Converter={StaticResource TranslatedStringConverter}}" Style="{StaticResource DetailedListText}" VerticalAlignment="Center" noesis:Text.StrokeThickness="4" noesis:Text.Stroke="{StaticResource LS_PrimaryColorOutlineColor}">
                    <TextBlock.Effect>
                        <DropShadowEffect Direction="270" Color="{StaticResource LS_PrimaryColorDropShadowColor}" ShadowDepth="3.0" BlurRadius="8.0"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=VSWS_State}" Value="Visible">
                <Setter Property="Style" TargetName="icon">
                    <Setter.Value>
                        <Style TargetType="Image">
                            <Style.Resources>
                                <ImageSource x:Key="IconNormal">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_d.png</ImageSource>
                                <ImageSource x:Key="IconHighlight">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_h.png</ImageSource>
                                <ImageSource x:Key="IconPressed">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_h.png</ImageSource>
                            </Style.Resources>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Text" TargetName="HelmetToggleString" Value="{Binding Source='h153c3f7cga3aeg4d25gb8dcg439be99a27e1',Converter={StaticResource TranslatedStringConverter}}"/>

            </DataTrigger>

            <DataTrigger Binding="{Binding Text, ElementName=VSWS_State}" Value="ActiveSet">
                <Setter Property="Style" TargetName="icon">
                    <Setter.Value>
                        <Style TargetType="Image">
                            <Style.Resources>
                                <ImageSource x:Key="IconNormal">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_d.png</ImageSource>
                                <ImageSource x:Key="IconHighlight">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_h.png</ImageSource>
                                <ImageSource x:Key="IconPressed">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_h.png</ImageSource>
                            </Style.Resources>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Text" TargetName="HelmetToggleString" Value="{Binding Source='h02045512g42b3g4e65gbb80g2860f50b9145',Converter={StaticResource TranslatedStringConverter}}"/>

                <Setter Property="Visibility" TargetName="VSWS_SetMark" Value="Visible"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding SlotType}" Value="RangedMainHand">
                <Setter Property="HorizontalAlignment" TargetName="VSWS_Label" Value="Right"/>
                <Setter Property="Margin" TargetName="VSWS_Label" Value="-900,0,48,0"/>
                <Setter Property="Source" TargetName="VSWS_SetMark" Value="pack://application:,,,/Core;component/Assets/CharacterPanel_c/c_ico_equipment_rangedSet_h.png"/>
                <Setter Property="Width" TargetName="VSWS_SetMark" Value="23"/>
                <Setter Property="Height" TargetName="VSWS_SetMark" Value="23"/>
                <Setter Property="RenderTransform" TargetName="VSWS_SetMark">
                    <Setter.Value>
                        <RotateTransform Angle="0"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <DataTrigger Binding="{Binding SlotType}" Value="RangedOffHand">
                <Setter Property="HorizontalAlignment" TargetName="VSWS_Label" Value="Right"/>
                <Setter Property="Margin" TargetName="VSWS_Label" Value="-900,0,48,0"/>
                <Setter Property="Source" TargetName="VSWS_SetMark" Value="pack://application:,,,/Core;component/Assets/CharacterPanel_c/c_ico_equipment_rangedSet_h.png"/>
                <Setter Property="Width" TargetName="VSWS_SetMark" Value="23"/>
                <Setter Property="Height" TargetName="VSWS_SetMark" Value="23"/>
                <Setter Property="RenderTransform" TargetName="VSWS_SetMark">
                    <Setter.Value>
                        <RotateTransform Angle="0"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <DataTrigger Binding="{Binding Text, ElementName=VSWS_State}" Value="CinematicsHidden">
                <Setter Property="Style" TargetName="icon">
                    <Setter.Value>
                        <Style TargetType="Image">
                            <Style.Resources>
                                <ImageSource x:Key="IconNormal">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_dialogueNone_d.png</ImageSource>
                                <ImageSource x:Key="IconHighlight">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_dialogueNone_h.png</ImageSource>
                                <ImageSource x:Key="IconPressed">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_dialogueNone_h.png</ImageSource>
                            </Style.Resources>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Text" TargetName="HelmetToggleString" Value="{Binding Source='h4015e57fg601ag44eagac2fga543834139c8',Converter={StaticResource TranslatedStringConverter}}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Text, ElementName=VSWS_State}" Value="Hidden">
                <Setter Property="Style" TargetName="icon">
                    <Setter.Value>
                        <Style TargetType="Image">
                            <Style.Resources>
                                <ImageSource x:Key="IconNormal">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_none_d.png</ImageSource>
                                <ImageSource x:Key="IconHighlight">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_none_h.png</ImageSource>
                                <ImageSource x:Key="IconPressed">pack://application:,,,/Core;component/Assets/Equipment/ico_visibility_none_h.png</ImageSource>
                            </Style.Resources>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Text" TargetName="HelmetToggleString" Value="{Binding Source='hb8aca5ffg5327g491eg9cd9gcfcde0e667bd',Converter={StaticResource TranslatedStringConverter}}"/>

            </DataTrigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Source" Value="pack://application:,,,/Core;component/Assets/Equipment/toggle_visibility_h_active.png" TargetName="frame"/>
                <Setter Property="Source" Value="{DynamicResource IconHighlight}" TargetName="icon"/>
                <Setter Property="Visibility" Value="Visible" TargetName="VSWS_Label"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Source" Value="pack://application:,,,/Core;component/Assets/Equipment/toggle_visibility_h_active.png" TargetName="frame"/>
                <Setter Property="Source" Value="{DynamicResource IconPressed}" TargetName="icon"/>
            </Trigger>

            <DataTrigger Binding="{Binding IsSelecting}" Value="True">
                <Setter TargetName="DimDownVisibilityCover" Property="Visibility" Value="Hidden"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.PlayerCharacterProperties.PlayerCharacterProperties.ActiveEquipmentSlot, ElementName=EquipmentSlots, Converter={StaticResource NullToBoolFalseConverter}}" Value="False">
                <Setter TargetName="DimDownVisibilityCover" Property="Visibility" Value="Hidden"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="VSWS_WeaponEQTemplate" TargetType="Control">
        <Grid x:Name="VSWS_Root" HorizontalAlignment="Left">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="Loaded">
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_CharacterCommand, ElementName=ContentRoot}" CommandParameter="{Binding DataContext, ElementName=EquipmentSlots}"/>
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_SlotCommand, ElementName=ContentRoot}" CommandParameter="{Binding DataContext, ElementName=VSWS_Root}"/>
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_ShowCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=VSWS_State}"/>
                </b:EventTrigger>
                <b:EventTrigger EventName="MouseEnter">
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_CharacterCommand, ElementName=ContentRoot}" CommandParameter="{Binding DataContext, ElementName=EquipmentSlots}"/>
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_SlotCommand, ElementName=ContentRoot}" CommandParameter="{Binding DataContext, ElementName=VSWS_Root}"/>
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_ShowCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=VSWS_State}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <TextBlock x:Name="VSWS_State" Text="Visible" Visibility="Collapsed"/>
            <ls:LSButton x:Name="EquipmentWeaponSlot" Style="{StaticResource EquipmentSlotStyle}" Tag="{TemplateBinding Tag}"/>
            <ls:LSButton x:Name="VisibilityButton" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-4,-40,0,0" Template="{StaticResource VSWS_VisibilityButtonTemplate}" Opacity="0">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="Click">
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_CharacterCommand, ElementName=ContentRoot}" CommandParameter="{Binding DataContext, ElementName=EquipmentSlots}"/>
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_SlotCommand, ElementName=ContentRoot}" CommandParameter="{Binding DataContext, ElementName=VSWS_Root}"/>
                    <b:InvokeCommandAction Command="{Binding Tag.VSWS_ToggleCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=VSWS_State}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ls:LSButton>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" TargetName="VisibilityButton"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="VSWS_WeaponSlotStyle" TargetType="Control">
        <Setter Property="Panel.ZIndex" Value="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="30"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="CharacterEquipmentTemplate" TargetType="Control">
        <Grid x:Name="CharacterPanelHolder" Tag="{Binding PlayerCharacterProperties.IsContentEditable}">
            <b:Interaction.Triggers>

                <!--Selecting the slot while it's not active = enabling all the filters-->
                <b:PropertyChangedTrigger Binding="{Binding PlayerCharacterProperties.ActiveEquipmentSlot}" >
                    <b:Interaction.Behaviors>
                        <b:ConditionBehavior>
                            <b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding PlayerCharacterProperties.ActiveEquipmentSlot}" Operator="NotEqual" RightOperand="{x:Null}"/>
                            </b:ConditionalExpression>
                        </b:ConditionBehavior>
                    </b:Interaction.Behaviors>
                    <b:ChangePropertyAction TargetName="FilteringContainerHolder" PropertyName="CurrentFilter" Value="{Binding PlayerCharacterProperties.ActiveEquipmentSlot.FilterType}"/>
                    <b:ChangePropertyAction TargetName="ChangePartyContextButton" PropertyName="IsChecked" Value="True"/>
                    <b:InvokeCommandAction Command="{Binding DataContext.SelectCharacter, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding}"/>
                </b:PropertyChangedTrigger>

                <!--Selecting the slot while it's active = no more filtering-->
                <b:DataTrigger Binding="{Binding PlayerCharacterProperties.ActiveEquipmentSlot}" Value="{x:Null}">
                    <b:ChangePropertyAction TargetName="FilteringContainerHolder" PropertyName="CurrentFilter" Value="{x:Null}"/>
                    <b:ChangePropertyAction TargetName="ChangePartyContextButton" PropertyName="IsChecked" Value="False"/>
                </b:DataTrigger>

                <b:DataTrigger Binding="{Binding IsVisible, ElementName=CharacterPanelHolder}" Value="True">
                    <!--Tutorial UI Event - Equipment Opened-->
                    <b:InvokeCommandAction Command="{Binding DataContext.TutorialEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="56affdac-faef-448a-94fb-55182779b482"/>
                </b:DataTrigger>

            </b:Interaction.Triggers>
            <Grid x:Name="EquipmentHolder" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- EQUIPMENT SLOTS -->
                <Grid x:Name="EquipmentSlots" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Thickness x:Key="EquipMargin">0,72,0,0</Thickness>
                    </Grid.Resources>

                    <DockPanel Name="EquipmentRight" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" Margin="{StaticResource EquipMargin}">

                        <Control DockPanel.Dock="Bottom" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Template="{StaticResource MuscialEQTemplate}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.MusicalInstrument}"/>
                        <StackPanel DockPanel.Dock="Top">
                            <!--VANITY-->
                            <Grid HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="VanityToggleHighlight" Grid.RowSpan="2" BorderBrush="{StaticResource LS_tempHPColor}" BorderThickness="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="-3" Background="{StaticResource InventoryBGShade}" Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="{StaticResource tempHPColor}" />
                                    </Border.Effect>
                                </Border>

                                <!-- Setting the Tag on the equipmentslots, because in Trade trying to set the ls:TooltipExtender.Owner to the correct 'CurrentTradingCharacter', doesn't trigger inheritance of the property on the first opening of the tooltips. 
                                        and if the property changes it's also not reacting as long as this inheritance is broken.-->
                                <ls:LSButton x:Name="VanityBodySlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Grid.Row="0" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.VanityBody}"/>
                                <ls:LSButton x:Name="VanityBootsSlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Grid.Row="1" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.VanityBoots}"/>
                                <ls:LSButton x:Name="ArmorVisibilityToggle" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Grid.RowSpan="2" VerticalAlignment="Top" Command="{Binding DataContext.ToggleArmorSetVisibility, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}" CommandParameter="{Binding .}" Template="{StaticResource VanityButtonTemplate}" HorizontalAlignment="Right" Margin="0,-40,-6,0">
                                    <ls:LSButton.ToolTip>
                                        <ls:LSTooltip Content="{Binding Source='had94b224g2d0eg43a9g96a7g27311c05ef99',Converter={StaticResource TranslatedStringConverter}}" x:Name="TooltipContent"/>
                                    </ls:LSButton.ToolTip>
                                </ls:LSButton>
                            </Grid>
                            <ls:LSButton x:Name="VanityUnderwearSlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Margin="0,24" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Underwear}"/>
                            <ls:LSButton x:Name="EquipmentAmuletSlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Amulet}"/>
                            <ls:LSButton x:Name="EquipmentRing1Slot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Ring}"/>
                            <ls:LSButton x:Name="EquipmentRing2Slot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Ring2}"/>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Name="EquipmentLeft" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" Margin="{StaticResource EquipMargin}">
                        <!--LIGHTSOURCE-->
                        <ls:LSButton x:Name="LightSource" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotBaseStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.LightSource}" ToolTipService.Placement="Left">
                            <b:Interaction.Behaviors>
                                <ls:DropOnGenericBehavior DropCommand="{Binding DataContext.DropLightSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"/>
                            </b:Interaction.Behaviors>
                        </ls:LSButton>

                        <StackPanel DockPanel.Dock="Top">

                            <Control Template="{StaticResource HelmetEQTemplate}" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Helmet}" ToolTipService.Placement="Left"/>
                            <ls:LSButton x:Name="EquipmentCloakSlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Cloak}" ToolTipService.Placement="Left"/>
                            <ls:LSButton x:Name="EquipmentBreastSlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Breast}" ToolTipService.Placement="Left"/>
                            <ls:LSButton x:Name="EquipmentGlovesSlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Gloves}" ToolTipService.Placement="Left"/>
                            <ls:LSButton x:Name="EquipmentBootsSlot" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource EquipmentSlotStyle}" Panel.ZIndex="{Binding IsSelecting, Converter={StaticResource BoolToIntConverter}, ConverterParameter=20}" DataContext="{Binding Equipment.Boots}" ToolTipService.Placement="Left"/>
                        </StackPanel>

                    </DockPanel>

                    <!--Melee Weapons-->
                    <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Bottom">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Panel.ZIndex" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource DetailedListText}" Text="{Binding Source='hde2dafecgf6f5g489ag9baeg23d0610570f5',Converter={StaticResource TranslatedStringConverter}}" TextAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" noesis:Text.StrokeThickness="4" noesis:Text.Stroke="{StaticResource LS_PrimaryColorOutlineColor}">
                            <TextBlock.Effect>
                                <DropShadowEffect Direction="270" Color="{StaticResource LS_PrimaryColorDropShadowColor}" ShadowDepth="3.0" BlurRadius="8.0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Control Template="{StaticResource VSWS_WeaponEQTemplate}" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource VSWS_WeaponSlotStyle}" DataContext="{Binding Equipment.MeleeMainHand}" ToolTipService.Placement="Left"/>
                            <Control Template="{StaticResource VSWS_WeaponEQTemplate}" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource VSWS_WeaponSlotStyle}" DataContext="{Binding Equipment.MeleeOffHand}" ToolTipService.Placement="Left"/>
                        </StackPanel>
                    </StackPanel>


                    <!--Ranged Weapons-->
                    <StackPanel Grid.Column="2" Grid.Row="1" VerticalAlignment="Bottom">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Panel.ZIndex" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource DetailedListText}" Text="{Binding Source='h52df2583g5fc1g4182g9511g36238e4e0c19',Converter={StaticResource TranslatedStringConverter}}" TextAlignment="Center" IsHitTestVisible="False" TextWrapping="Wrap" noesis:Text.StrokeThickness="4" noesis:Text.Stroke="{StaticResource LS_PrimaryColorOutlineColor}">
                            <TextBlock.Effect>
                                <DropShadowEffect Direction="270" Color="{StaticResource LS_PrimaryColorDropShadowColor}" ShadowDepth="3.0" BlurRadius="8.0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Control Template="{StaticResource VSWS_WeaponEQTemplate}" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource VSWS_WeaponSlotStyle}" DataContext="{Binding Equipment.RangedMainHand}"/>
                            <Control Template="{StaticResource VSWS_WeaponEQTemplate}" Tag="{Binding DataContext, ElementName=EquipmentSlots}" Style="{StaticResource VSWS_WeaponSlotStyle}" DataContext="{Binding Equipment.RangedOffHand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--ArmorClass-->
                    <Control Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Template="{StaticResource ACHolder}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                </Grid>

                <Control Grid.Row="2" Template="{StaticResource WeaponAttackBonusTemplate}" VerticalAlignment="Bottom" Margin="0,8,0,20"/>

            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding PlayerCharacterProperties.ArmorSetVisibility}" Value="Vanity">
                <Setter TargetName="VanityToggleHighlight" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
