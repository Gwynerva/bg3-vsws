                    <!-- The mode of each weapon slot, written by the mod's Lua and read by the triggers below.
                         Refreshed when the popup is created, each time it is opened or closed, and whenever
                         another character is selected. -->
                    <Grid x:Name="GwyVS_Host" Width="0" Height="0">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Loaded">
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_CharacterCommand, ElementName=ContentRoot}" CommandParameter="{Binding CurrentPlayer.SelectedCharacter}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowMeleeMainHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_MeleeMainHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowMeleeOffHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_MeleeOffHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowRangedMainHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_RangedMainHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowRangedOffHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_RangedOffHandState}"/>
                            </b:EventTrigger>
                            <b:PropertyChangedTrigger Binding="{Binding CurrentPlayer.SelectedCharacter}">
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_CharacterCommand, ElementName=ContentRoot}" CommandParameter="{Binding CurrentPlayer.SelectedCharacter}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowMeleeMainHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_MeleeMainHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowMeleeOffHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_MeleeOffHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowRangedMainHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_RangedMainHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowRangedOffHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_RangedOffHandState}"/>
                            </b:PropertyChangedTrigger>
                            <b:PropertyChangedTrigger Binding="{Binding IsEnabled, ElementName=EquipmentOptions}">
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_CharacterCommand, ElementName=ContentRoot}" CommandParameter="{Binding CurrentPlayer.SelectedCharacter}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowMeleeMainHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_MeleeMainHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowMeleeOffHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_MeleeOffHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowRangedMainHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_RangedMainHandState}"/>
                                <b:InvokeCommandAction Command="{Binding Tag.GwyVS_ShowRangedOffHandCommand, ElementName=ContentRoot}" CommandParameter="{Binding ElementName=GwyVS_RangedOffHandState}"/>
                            </b:PropertyChangedTrigger>
                        </b:Interaction.Triggers>
                        <TextBlock x:Name="GwyVS_MeleeMainHandState" Text="Visible" Visibility="Collapsed"/>
                        <TextBlock x:Name="GwyVS_MeleeOffHandState" Text="Visible" Visibility="Collapsed"/>
                        <TextBlock x:Name="GwyVS_RangedMainHandState" Text="Visible" Visibility="Collapsed"/>
                        <TextBlock x:Name="GwyVS_RangedOffHandState" Text="Visible" Visibility="Collapsed"/>
                    </Grid>

